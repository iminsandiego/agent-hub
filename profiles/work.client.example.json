{
  "schema_version": 1,
  "url": "https://memory-work.example.com",
  "machine_id": "replace-execution-host-work",
  "domain": "work",
  "strict_scope": true,
  "allowed_projects": [
    "work-atlas"
  ],
  "token_env": "AGENT_HUB_WORK_TOKEN",
